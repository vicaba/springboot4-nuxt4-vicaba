{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "npm run generate:types && nuxt generate",
    "generate:types": "openapi-typescript ../openapi/api.yaml -o ./app/types/api.d.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run generate:types",
    "deps:check": "npx taze major -l",
    "deps:update": "npx taze major -wil"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
